<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.webautomation.kaspi_hourly_snapshot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd __REPO_ROOT__ &amp;&amp; __REPO_ROOT__/web-auto snapshot hourly --config config/tasks/kaspi_hourly_snapshot.yaml --headless</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/runs/kaspi_hourly_snapshots/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/runs/kaspi_hourly_snapshots/launchd.err.log</string>
</dict>
</plist>
