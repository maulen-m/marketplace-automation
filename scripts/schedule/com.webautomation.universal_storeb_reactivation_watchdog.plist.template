<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.webautomation.universal_storeb_reactivation_watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd __REPO_ROOT__ &amp;&amp; __REPO_ROOT__/.venv/bin/python -m web_auto.universal_storeb_watchdog --json run --config config/tasks/universal_storeb_reactivation_watchdog.yaml --refresh-kaspi --refresh-repricer --headless</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StartInterval</key>
  <integer>86400</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/runs/universal_storeb_reactivation_watchdog/logs/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/runs/universal_storeb_reactivation_watchdog/logs/stderr.log</string>
</dict>
</plist>
